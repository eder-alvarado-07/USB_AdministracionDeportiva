# ── Base de datos PostgreSQL ─────────────────────────────
# Opción 1 (recomendada en la nube: Neon, Render, Railway…)
DATABASE_URL=
# Opción 2 (PostgreSQL local) — se usa si DATABASE_URL está vacío
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dt_deportivo

# ── Autenticación ────────────────────────────────────────
# Obligatorios en producción: mínimo 32 caracteres y distintos entre sí. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Clave inicial para los usuarios que crean `npm run seed` y `npm run demo`.
# Si se deja vacía, se genera una aleatoria por usuario y se muestra una sola vez.
SEED_CLAVE_INICIAL=

# ── Frontend permitido por CORS (backend/server.js) ──────
FRONTEND_URL=

# ── Despliegue (Railway) ─────────────────────────────────
# Carpeta de fotos y logos; en Railway, la ruta del volumen (por ejemplo /data/uploads)
UPLOADS_DIR=
# 1 = cargar el plantel de demostración al desplegar (solo para la versión de pruebas)
DATOS_DEMO=
# false = conectar a PostgreSQL sin SSL (red privada)
DB_SSL=
